# Copy to .env for local development (never commit the real .env).
# In production these are GitHub Actions Secrets/Variables, not a file.

# --- Email recipients (non-secret; a repo Variable in CI) --------------------
ALERT_EMAIL_TO=compras@tuempresa.com

# --- Email transport: set ONE of the following groups ------------------------
# SMTP (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=tucuenta@gmail.com
# SMTP_TLS=true

# SendGrid
# SENDGRID_API_KEY=SG.xxxxx
# ALERT_EMAIL_FROM=alertas@tudominio.com

# Resend
# RESEND_API_KEY=re_xxxxx
# ALERT_EMAIL_FROM=alertas@tudominio.com

# --- Source APIs (optional; enable the matching source in config.yml) --------
# eBay Browse API
# EBAY_CLIENT_ID=YourApp-xxxx
# EBAY_CLIENT_SECRET=xxxx

# Amazon Product Advertising API 5.0
# AMAZON_ACCESS_KEY=xxxx
# AMAZON_SECRET_KEY=xxxx
# AMAZON_PARTNER_TAG=yourtag-20
